<script def>
{ "navigationBarTitleText": "AIR WX Setup", "description": "Choose language, two custom ICAO lists, TAF preference and Nearby explanation. English, Japanese, Korean and Chinese." }
</script>
<script setup>
import wx from 'wx';
import { languages, strings } from '../../lib/i18n.js';
import { parseCodes, settings } from '../../lib/model.js';
import { readSettings, saveSettings } from '../../lib/storage.js';
function valueOf(event) { return event?.detail?.value ?? event?.currentTarget?.value ?? ''; }
export default {
  data: { copy: strings('en'), locale: 'en', tab: 'list1', list1: '', list2: '', includeTaf: false, note: '', languages },
  onLoad() { this._dead = false; this._visible = false; this._focused = true; const result = readSettings(wx); this._prefs = result.value; this.setData({ ...this._prefs, copy: strings(this._prefs.locale), note: result.warning ? strings(this._prefs.locale).storageWarning : '' }); },
  onShow() { this._visible = true; }, onHide() { this._visible = false; }, onUnload() { this._dead = true; this._visible = false; },
  onHostFocus() { this._focused = true; }, onHostBlur() { this._focused = false; }, active() { return !this._dead && this._visible && this._focused; },
  chooseTab(event) { const tab = event?.currentTarget?.dataset?.tab; if (['list1','list2','language','about'].includes(tab) && this.active()) this.setData({ tab, note: '' }); },
  listInput(event) { const key = this.data.tab === 'list2' ? 'list2' : 'list1'; if (this.active()) this.setData({ [key]: valueOf(event), note: '' }); },
  saveList() { if (!this.active()) return; const key = this.data.tab === 'list2' ? 'list2' : 'list1'; const result = parseCodes(this.data[key]); if (this.data[key].trim() && !result.valid) { this.setData({ note: this.data.copy.invalid }); return; } this._prefs = settings({ ...this._prefs, [key]: result.codes.join(', ') }); const ok = saveSettings(wx, this._prefs); this.setData({ ...this._prefs, note: ok ? this.data.copy.saved : this.data.copy.storageWarning }); },
  clearList() { const key = this.data.tab === 'list2' ? 'list2' : 'list1'; if (this.active()) { this.setData({ [key]: '', note: '' }); this._prefs = settings({ ...this._prefs, [key]: '' }); saveSettings(wx, this._prefs); } },
  chooseLanguage(event) { const locale = event?.currentTarget?.dataset?.locale; if (!languages.some(item => item.code === locale) || !this.active()) return; this._prefs = settings({ ...this._prefs, locale }); saveSettings(wx, this._prefs); this.setData({ locale, copy: strings(locale), note: '' }); },
  toggleTaf() { if (!this.active()) return; this._prefs = settings({ ...this._prefs, includeTaf: !this.data.includeTaf }); saveSettings(wx, this._prefs); this.setData({ includeTaf: this._prefs.includeTaf }); },
  back() { if (this.active()) wx.navigateBack({ delta: 1 }); },
  onKeyUp(event) { if (event.code === 'Backspace' && this.active()) { event.preventDefault(); this.back(); } }
};
</script>
<page>
  <view class="settings">
    <view class="heading"><view><text class="eyebrow">AIR WX / CONFIG</text><text class="title">{{copy.settings}}</text></view><button class="back" bindtap="back">{{copy.back}}</button></view>
    <view class="tabs" role="navigation"><button class="tab {{tab === 'list1' ? 'selected' : ''}}" data-tab="list1" bindtap="chooseTab">{{copy.list1}}</button><button class="tab {{tab === 'list2' ? 'selected' : ''}}" data-tab="list2" bindtap="chooseTab">{{copy.list2}}</button><button class="tab {{tab === 'language' ? 'selected' : ''}}" data-tab="language" bindtap="chooseTab">{{copy.language}}</button><button class="tab {{tab === 'about' ? 'selected' : ''}}" data-tab="about" bindtap="chooseTab">{{copy.about}}</button></view>
    <view ink:if="{{tab === 'list1' || tab === 'list2'}}" class="panel"><text class="label">{{copy.listLabel}} · {{tab === 'list1' ? copy.list1 : copy.list2}}</text><input class="field" value="{{tab === 'list1' ? list1 : list2}}" placeholder="{{copy.placeholder}}" maxLength="64" bindinput="listInput" /><text class="help">{{copy.listHelp}}</text><view class="actions" role="navigation"><button class="action" bindtap="saveList">{{copy.save}}</button><button class="action secondary" bindtap="clearList">{{copy.clear}}</button></view></view>
    <view ink:if="{{tab === 'language'}}" class="panel"><text class="label">{{copy.language}}</text><view class="languages" role="navigation"><button ink:for="{{languages}}" ink:key="code" class="language {{locale === item.code ? 'selected' : ''}}" data-locale="{{item.code}}" bindtap="chooseLanguage">{{item.label}}</button></view><text class="help">{{copy.languageHelp}}</text></view>
    <view ink:if="{{tab === 'about'}}" class="panel about"><text class="label">{{copy.notice}}</text><text class="help">{{copy.source}}</text><text class="help">{{copy.privacy}}</text><text class="help">{{copy.radius}}</text><button class="taf" bindtap="toggleTaf">{{includeTaf ? copy.tafOn : copy.tafOff}}</button></view>
    <text class="notice">{{copy.safety}}</text><text class="note">{{note}}</text><text class="foot">AIR WX / METAR + TAF / {{copy.safety}}</text>
  </view>
</page>
<style>
.settings { width: 100%; height: 100%; box-sizing: border-box; padding: 12px 16px; display: flex; flex-direction: column; background-color: #000; color: #00ff66; }.heading { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }.eyebrow { display: block; font-family: monospace; font-size: 10px; line-height: 13px; color: #00bc4b; }.title { display: block; font-size: 23px; line-height: 27px; font-weight: 700; }.back { min-height: 30px; height: 30px; font-size: 13px; padding: 4px 10px; }.tabs { display: flex; flex-direction: row; margin-top: 10px; margin-bottom: 13px; }.tab { flex: 1; min-height: 30px; height: 30px; font-size: 12px; padding: 4px 2px; margin-right: 5px; }.tab:last-child { margin-right: 0; }.selected { border-color: #00ff66; background-color: #001f0d; font-weight: 700; }.panel { flex: 1; min-height: 0; display: flex; flex-direction: column; }.label { font-size: 14px; line-height: 20px; color: #00d856; }.field { width: 100%; height: 44px; min-height: 44px; margin-top: 7px; border: 1px solid #008f39; border-radius: 4px; box-sizing: border-box; padding: 8px; font-family: monospace; font-size: 16px; }.help { font-size: 12px; line-height: 18px; margin-top: 11px; color: #00bc4b; }.actions { display: flex; flex-direction: row; margin-top: 17px; }.action { flex: 1; min-height: 32px; height: 32px; font-size: 13px; padding: 5px; margin-right: 7px; }.action:last-child { margin-right: 0; }.secondary { background-color: #000; }.languages { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 10px; }.language { width: 47%; min-height: 43px; height: 43px; margin-right: 3%; margin-bottom: 10px; padding: 7px; font-size: 17px; }.about .help { margin-top: 13px; }.taf { align-self: flex-start; min-height: 32px; height: 32px; margin-top: 16px; padding: 5px 12px; font-size: 13px; }.notice { font-family: monospace; font-size: 10px; line-height: 14px; color: #00bc4b; margin-top: 8px; }.note { min-height: 18px; font-size: 12px; line-height: 18px; color: #00ff66; }.foot { font-family: monospace; font-size: 9px; line-height: 14px; color: #00bc4b; }
@media (target: _current) { .settings { padding: 9px 12px; }.title { font-size: 20px; }.tabs { margin-top: 6px; margin-bottom: 8px; }.tab { font-size: 10px; min-height: 27px; height: 27px; }.field { height: 37px; min-height: 37px; font-size: 14px; }.help { font-size: 10px; line-height: 14px; margin-top: 7px; }.actions { margin-top: 10px; }.languages { margin-top: 6px; }.language { min-height: 35px; height: 35px; font-size: 14px; }.notice { font-size: 8px; }.foot { display: none; } }
</style>
